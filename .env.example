# GROQ_API_KEY: Primary AI provider key for ResumeRank AI backend (/api/analyze).
# Get a free key from https://console.groq.com/keys and set it as a server/Wrangler secret.
GROQ_API_KEY="your_key_here"

# GEMINI_API_KEY: Optional fallback AI provider key if GROQ_API_KEY is not set.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
